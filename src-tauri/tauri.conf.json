{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brickpress",
  "version": "1.0.1",
  "identifier": "io.github.aqualy.brickpress",
  "build": {
    "beforeDevCommand": "npm run desktop:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brickpress",
        "create": false,
        "width": 1448,
        "height": 960,
        "minWidth": 320,
        "minHeight": 480,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Compose brick shapes and simulate printed impressions",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../static/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../static/RUST_DEPENDENCY_NOTICES.txt": "RUST_DEPENDENCY_NOTICES.txt",
      "../NOTICE.md": "NOTICE.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "branding/installer-header.bmp",
        "uninstallerHeaderImage": "branding/installer-header.bmp",
        "sidebarImage": "branding/installer-sidebar.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
