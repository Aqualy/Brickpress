{
  "name": "brickpress",
  "version": "1.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run notices && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "desktop:frontend": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:prepare:e2e": "node scripts/desktop-prepare.mjs --e2e",
    "desktop:build:e2e": "node scripts/desktop-build.mjs --e2e",
    "desktop:test": "wdio run wdio.conf.ts",
    "notices:rust": "node scripts/generate-rust-notices.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.52.0",
    "@playwright/test": "^1.56.0",
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.48.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^20.19.43",
    "@wdio/cli": "9.30.1",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/spec-reporter": "9.30.1",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.4.0",
    "ajv": "^8.17.1",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.43.0",
    "svelte-check": "^4.3.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vitest": "^4.1.11",
    "webdriverio": "9.30.1"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "basic-ftp": "6.2.2",
    "deepmerge-ts": "8.0.2",
    "serialize-javascript": "7.1.2"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1"
  }
}
